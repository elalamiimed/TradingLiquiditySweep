[run]
source = src
branch = True
omit =
    */__pycache__/*
    */site-packages/*
    src/utils/__init__.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @property

show_missing = True
precision = 2
